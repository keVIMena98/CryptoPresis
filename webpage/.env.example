# CryptoPresis Environment Configuration
# Copy this file to .env.local and fill in your values

# Contract Configuration
VITE_CONTRACT_ADDRESS=0x3ee15e0b8d236f7741ca5c1259fbcf1544e51621
VITE_NETWORK_ID=1
VITE_NETWORK_NAME=Ethereum

# IPFS Configuration
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# RPC Configuration (Optional - uses MetaMask's provider by default)
# VITE_INFURA_KEY=your_infura_key_here
# VITE_ALCHEMY_KEY=your_alchemy_key_here

# Analytics (Optional)
# VITE_GA_TRACKING_ID=your_google_analytics_id

# Environment
VITE_ENV=development
